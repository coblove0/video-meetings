generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  meetings     Meeting[]
}

model Meeting {
  id           String        @id @default(uuid())
  title        String
  date         DateTime
  participants String[]
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  files        MeetingFile[]
}

model MeetingFile {
  id           String   @id @default(uuid())
  originalName String
  size         Int
  mimeType     String
  storagePath  String
  createdAt    DateTime @default(now())
  meetingId    String
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}
