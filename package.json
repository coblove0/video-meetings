{
  "name": "video-meetings",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run start:dev -w api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w web",
    "build:api": "npm run build -w api",
    "lint": "npm run lint --workspaces --if-present",
    "lint:web": "npm run lint -w web",
    "lint:api": "npm run lint -w api",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "npm run test:all --workspaces --if-present",
    "test:api": "npm run test -w api"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "prettier": "^3.4.2"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "bcrypt@6.0.0": true,
    "prisma@7.8.0": true
  }
}
